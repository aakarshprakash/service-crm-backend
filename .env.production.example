# Production environment – copy to ../.env.production (used by docker-compose.yml).
# Never commit the filled-in file.

APP_NAME="ServiceCRM"
APP_ENV=production
APP_DEBUG=false
# docker compose run --rm --entrypoint php app artisan key:generate --show
APP_KEY=
APP_URL=https://crm.example.com
FRONTEND_URL=https://crm.example.com
TRIAL_DAYS=14

# Created on first start (password must be strong; change after first login).
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=service_crm
DB_USERNAME=crm
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Stateless app servers: sessions, cache and queues in Redis (horizontal scaling).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=crm.example.com
SANCTUM_STATEFUL_DOMAINS=crm.example.com
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BCRYPT_ROUNDS=12

# The TLS proxy in front of the container (use its IP/CIDR, or * behind a managed LB).
TRUSTED_PROXIES=*

# Private files (job photos, logos, exports). Use S3 / DigitalOcean Spaces in production.
PRIVATE_DISK_DRIVER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Online payments (optional – offline collection works without a gateway).
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Messaging: sms = log|msg91|twilio · whatsapp = log|meta|twilio · push = log|fcm
SMS_DRIVER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_DRIVER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
PUSH_DRIVER=fcm
FCM_CREDENTIALS=/var/www/app/storage/app/private/fcm.json
